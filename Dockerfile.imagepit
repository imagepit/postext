# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=books

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/books/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/books/.next/static ./apps/books/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/books/server.js"]
