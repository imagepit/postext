# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo
COPY . .
# esbuild（vitest と drizzle-kit が使う）の build script が未承認だと pnpm 12 は install を失敗させる。
# 実行時に不要なので不許可として宣言する。pnpm-workspace.yaml 自体は変えない。
RUN printf '  esbuild: false\n' >> pnpm-workspace.yaml
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter=books
# standalone 出力には migrator が入らないので、pg と drizzle-orm ごと1ファイルにまとめて持ち込む。
# pg-native は pg が任意で読む依存で、無くても動く。
RUN pnpm --dir apps/books exec esbuild src/db/migrate.ts --bundle --platform=node --format=cjs \
    --target=node22 --external:pg-native --outfile=/migrate/migrate.cjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/books/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/books/.next/static ./apps/books/.next/static
COPY --from=build --chown=node:node /migrate/migrate.cjs ./migrate.cjs
COPY --from=build --chown=node:node /repo/apps/books/drizzle ./drizzle
USER node
EXPOSE 3000
# DATABASE_URL があれば未適用のマイグレーションを適用してから起動する。無ければ migrate.cjs は何もしない。
CMD ["sh", "-c", "node migrate.cjs && exec node apps/books/server.js"]
